# Persistent SQLite database and generated site artifacts.
DATABASE_PATH=/app/data/company-creator.sqlite
ARTIFACTS_PATH=/app/data/sites

# Optional AI providers. The offline generator works without keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=

# Hard cap per company generation. One retry is allowed only inside this cap.
AI_OPERATION_BUDGET_USD=0.25
AI_MAX_RETRIES=1
AI_REQUEST_TIMEOUT_MS=90000

# Public application URL used only for absolute metadata when needed.
APP_URL=http://localhost:3000
