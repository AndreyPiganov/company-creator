# PostgreSQL is provided by Docker Compose. Override only for host development.
DATABASE_URL=postgresql://company_creator:company_creator@localhost:5432/company_creator

# Host-development service addresses. Docker uses same-origin requests through Nginx.
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000

# Optional AI providers. The offline generator works without keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=

# Hard cap per company generation. One retry is allowed only inside this cap.
AI_OPERATION_BUDGET_USD=0.25
AI_MAX_RETRIES=1
AI_REQUEST_TIMEOUT_MS=90000

# Public application URL used for provider metadata.
APP_URL=http://localhost:3000
